{
  "name": "stevenwilssens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/lastmod.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy --branch main",
    "db:migrate": "wrangler d1 migrations apply stevenwilssens-analytics --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
