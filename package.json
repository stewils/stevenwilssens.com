{
  "name": "stevenwilssens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/lastmod.mjs && node scripts/resume-check.mjs --json dist/resume-report.json",
    "resume:build": "node scripts/resume.mjs",
    "resume:check": "node scripts/resume-check.mjs",
    "check:site": "node scripts/site-check.mjs",
    "og:image": "node scripts/og-image.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy --branch main",
    "db:migrate": "wrangler d1 migrations apply stevenwilssens-analytics --remote",
    "test:coverage": "vitest run --coverage",
    "check:recruiter": "node scripts/recruiter-check.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-core": "^4.14.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "oxlint": "^1.88.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0",
    "zod": "^4.6.7"
  }
}
