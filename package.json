{
  "name": "stevenwilssens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/lastmod.mjs && node scripts/resume-check.mjs --json dist/resume-report.json",
    "resume:build": "node scripts/resume.mjs",
    "resume:check": "node scripts/resume-check.mjs",
    "og:image": "node scripts/og-image.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy --branch main",
    "db:migrate": "wrangler d1 migrations apply stevenwilssens-analytics --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0",
    "zod": "^4.6.7"
  }
}
